{% block kmh_demo_data_index %}
<sw-page class="kmh-demo-data-index">

    {% block kmh_demo_data_index_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('kmh-demo-data.general.mainMenuItemGeneral') }}</h2>
    </template>
    {% endblock %}

    {% block kmh_demo_data_index_actions %}
    <template #smart-bar-actions>
        <mt-button
            class="kmh-demo-data-index__generate"
            variant="primary"
            :disabled="isRunning || isLoading"
            :is-loading="isRunning"
            @click="onGenerate"
        >
            {{ $tc('kmh-demo-data.general.generate') }}
        </mt-button>
    </template>
    {% endblock %}

    {% block kmh_demo_data_index_content %}
    <template #content>
        <sw-card-view>

            {% block kmh_demo_data_index_options %}
            <mt-card
                position-identifier="kmh-demo-data-options"
                :title="$tc('kmh-demo-data.options.title')"
                :is-loading="isLoading"
            >
                <p class="kmh-demo-data-index__hint">
                    {{ $tc('kmh-demo-data.options.hint') }}
                </p>

                <sw-multi-select
                    v-model:value="selectedChannels"
                    class="kmh-demo-data-index__channels"
                    :options="channels"
                    label-property="name"
                    value-property="key"
                    :label="$tc('kmh-demo-data.options.channels')"
                    :helpText="$tc('kmh-demo-data.options.channelsHelp')"
                    :disabled="isRunning"
                />

                <mt-number-field
                    v-model="perCategory"
                    class="kmh-demo-data-index__per-category"
                    numberType="int"
                    :min="1"
                    :label="$tc('kmh-demo-data.options.perCategory')"
                    :helpText="$tc('kmh-demo-data.options.perCategoryHelp')"
                    :disabled="isRunning"
                />

                <mt-switch
                    v-model="withMedia"
                    class="kmh-demo-data-index__with-media"
                    :label="$tc('kmh-demo-data.options.withMedia')"
                    :helpText="$tc('kmh-demo-data.options.withMediaHelp')"
                    :disabled="isRunning"
                />

                <mt-switch
                    v-model="withOrders"
                    class="kmh-demo-data-index__with-orders"
                    :label="$tc('kmh-demo-data.options.withOrders')"
                    :helpText="$tc('kmh-demo-data.options.withOrdersHelp')"
                    :disabled="isRunning"
                />
            </mt-card>
            {% endblock %}

            {% block kmh_demo_data_index_b2b %}
            <mt-card
                position-identifier="kmh-demo-data-b2b"
                class="kmh-demo-data-index__b2b"
                :title="$tc('kmh-demo-data.b2b.title')"
                :is-loading="isLoading"
            >
                <p class="kmh-demo-data-index__hint">
                    {{ $t('kmh-demo-data.b2b.hint', { channel: b2b.channelName }) }}
                </p>

                {% block kmh_demo_data_index_b2b_unavailable %}
                <mt-banner
                    v-if="!b2b.available"
                    variant="neutral"
                    :title="$tc('kmh-demo-data.b2b.unavailableTitle')"
                >
                    {{ $tc('kmh-demo-data.b2b.unavailableBody') }}
                </mt-banner>
                {% endblock %}

                {% block kmh_demo_data_index_b2b_channel_missing %}
                <mt-banner
                    v-else-if="!b2b.channelReady"
                    variant="attention"
                    :title="$tc('kmh-demo-data.b2b.channelMissingTitle')"
                >
                    {{ $t('kmh-demo-data.b2b.channelMissingBody', { channel: b2b.channelName }) }}
                </mt-banner>
                {% endblock %}

                <template v-if="b2b.available">
                    <p
                        v-if="!b2b.lists"
                        class="kmh-demo-data-index__hint"
                    >
                        {{ $tc('kmh-demo-data.b2b.listsMissing') }}
                    </p>

                    {% block kmh_demo_data_index_b2b_companies %}
                    <sw-data-grid
                        class="kmh-demo-data-index__b2b-companies"
                        :dataSource="b2bCompanyRows"
                        :columns="b2bCompanyColumns"
                        :showSelection="false"
                        :showActions="false"
                        :plainAppearance="true"
                    />
                    {% endblock %}

                    {% block kmh_demo_data_index_b2b_logins %}
                    <template v-if="b2bLoginRows.length">
                        <h4 class="kmh-demo-data-index__subtitle">
                            {{ $tc('kmh-demo-data.b2b.loginsTitle') }}
                        </h4>
                        <p class="kmh-demo-data-index__hint">
                            {{ $t('kmh-demo-data.b2b.loginsHint', { password: b2b.password }) }}
                        </p>
                        <sw-data-grid
                            class="kmh-demo-data-index__b2b-logins"
                            :dataSource="b2bLoginRows"
                            :columns="b2bLoginColumns"
                            :showSelection="false"
                            :showActions="false"
                            :plainAppearance="true"
                        />
                    </template>
                    {% endblock %}
                </template>

                {% block kmh_demo_data_index_b2b_generate %}
                <div class="kmh-demo-data-index__b2b-actions">
                    <mt-button
                        class="kmh-demo-data-index__generate-b2b"
                        variant="primary"
                        :disabled="!canGenerateB2b"
                        :is-loading="isRunning"
                        @click="onGenerateB2b"
                    >
                        {{ $tc('kmh-demo-data.b2b.generate') }}
                    </mt-button>
                </div>
                {% endblock %}
            </mt-card>
            {% endblock %}

            {% block kmh_demo_data_index_status %}
            <mt-card
                position-identifier="kmh-demo-data-status"
                :title="$tc('kmh-demo-data.status.title')"
            >
                {% block kmh_demo_data_index_status_running %}
                <mt-banner
                    v-if="isRunning"
                    variant="info"
                    :title="$tc('kmh-demo-data.status.runningTitle')"
                >
                    {{ $tc('kmh-demo-data.status.runningBody') }}
                </mt-banner>
                {% endblock %}

                {% block kmh_demo_data_index_status_failed %}
                <mt-banner
                    v-else-if="status.state === 'failed'"
                    variant="critical"
                    :title="$tc('kmh-demo-data.status.failedTitle')"
                >
                    {{ status.message }}
                </mt-banner>
                {% endblock %}

                {% block kmh_demo_data_index_status_finished %}
                <mt-banner
                    v-else-if="status.state === 'finished'"
                    variant="positive"
                    :title="$tc('kmh-demo-data.status.finishedTitle')"
                >
                    {{ $t('kmh-demo-data.status.finishedBody', {
                        created: status.created,
                        enriched: status.enriched,
                    }) }}
                </mt-banner>
                {% endblock %}

                {% block kmh_demo_data_index_status_idle %}
                <mt-banner
                    v-else
                    variant="neutral"
                    :title="$tc('kmh-demo-data.status.idleTitle')"
                >
                    {{ $tc('kmh-demo-data.status.idleBody') }}
                </mt-banner>
                {% endblock %}

                {% block kmh_demo_data_index_status_report %}
                <sw-data-grid
                    v-if="hasReport"
                    class="kmh-demo-data-index__report"
                    :dataSource="reportRows"
                    :columns="reportColumns"
                    :showSelection="false"
                    :showActions="false"
                    :plainAppearance="true"
                />
                {% endblock %}

                {% block kmh_demo_data_index_status_notes %}
                <ul v-if="status.notes && status.notes.length" class="kmh-demo-data-index__notes">
                    <li v-for="(note, index) in status.notes" :key="index">{{ note }}</li>
                </ul>
                {% endblock %}
            </mt-card>
            {% endblock %}

            {% block kmh_demo_data_index_user %}
            <mt-card
                v-if="canManageUser"
                position-identifier="kmh-demo-data-user"
                :title="$tc('kmh-demo-data.user.title')"
            >
                <p class="kmh-demo-data-index__hint">
                    {{ $tc('kmh-demo-data.user.hint') }}
                </p>

                {% block kmh_demo_data_index_user_existing %}
                <mt-banner
                    v-if="demoUser.exists"
                    variant="positive"
                    :title="$tc('kmh-demo-data.user.existsTitle')"
                >
                    {{ $t('kmh-demo-data.user.existsBody', {
                        email: demoUser.email,
                        username: demoUser.username,
                        privileges: demoUser.privileges,
                    }) }}
                </mt-banner>
                {% endblock %}

                {% block kmh_demo_data_index_user_password %}
                <mt-banner
                    v-if="demoUserPassword"
                    variant="attention"
                    :title="$tc('kmh-demo-data.user.passwordTitle')"
                >
                    <code class="kmh-demo-data-index__password">{{ demoUserPassword }}</code>
                    <p>{{ $tc('kmh-demo-data.user.passwordBody') }}</p>
                </mt-banner>
                {% endblock %}

                <mt-text-field
                    v-model="demoUserEmail"
                    class="kmh-demo-data-index__user-email"
                    :label="$tc('kmh-demo-data.user.email')"
                    :placeholder="demoUser.email || 'demo@example.com'"
                    :disabled="isCreatingUser"
                />

                <mt-text-field
                    v-model="demoUserUsername"
                    class="kmh-demo-data-index__user-username"
                    :label="$tc('kmh-demo-data.user.username')"
                    :placeholder="demoUser.username || 'demo'"
                    :disabled="isCreatingUser"
                />

                <div class="kmh-demo-data-index__user-actions">
                    <mt-button
                        class="kmh-demo-data-index__create-user"
                        variant="primary"
                        :disabled="isCreatingUser"
                        :is-loading="isCreatingUser"
                        @click="onCreateDemoUser(false)"
                    >
                        {{ $tc(demoUser.exists ? 'kmh-demo-data.user.refresh' : 'kmh-demo-data.user.create') }}
                    </mt-button>

                    <mt-button
                        v-if="demoUser.exists"
                        class="kmh-demo-data-index__rotate-password"
                        variant="secondary"
                        :disabled="isCreatingUser"
                        @click="onCreateDemoUser(true)"
                    >
                        {{ $tc('kmh-demo-data.user.rotate') }}
                    </mt-button>
                </div>
            </mt-card>
            {% endblock %}

        </sw-card-view>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}
