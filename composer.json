{
    "name": "kommandhub/demo-data-sw",
    "description": "Seeds a realistic, idempotent Shopware 6 demo catalogue across multiple sales channels: root categories, products, variants, manufacturers, properties, media and tags.",
    "type": "shopware-platform-plugin",
    "version": "0.9.0-beta.2",
    "license": "proprietary",
    "keywords": [
        "shopware",
        "shopware6",
        "shopware-plugin",
        "demodata",
        "cli",
        "custom-fields"
    ],
    "homepage": "https://github.com/Kommandhub/KmhDemoDataSW",
    "authors": [
        {
            "name": "Kommandhub",
            "email": "info@kommandhub.com",
            "homepage": "https://kommandhub.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@kommandhub.com",
        "issues": "https://github.com/Kommandhub/KmhDemoDataSW/issues",
        "source": "https://github.com/Kommandhub/KmhDemoDataSW",
        "docs": "https://github.com/Kommandhub/KmhDemoDataSW/blob/main/README.md"
    },
    "require": {
        "php": ">=8.2",
        "shopware/core": "^6.6 || ^6.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "shopware/dev-tools": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Kommandhub\\DemoData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kommandhub\\DemoData\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Kommandhub\\DemoData\\KmhDemoDataSW",
        "label": {
            "de-DE": "Kommandhub Demodaten für Shopware 6",
            "en-GB": "Kommandhub Demo Data for Shopware 6",
            "fr-FR": "Données de démonstration Kommandhub pour Shopware 6"
        },
        "description": {
            "de-DE": "Erzeugt einen realistischen, idempotenten Shopware-6-Demokatalog \u00fcber mehrere Verkaufskan\u00e4le: Wurzelkategorien, Produkte, Varianten, Hersteller, Eigenschaften, Medien und Tags.",
            "en-GB": "Seeds a realistic, idempotent Shopware 6 demo catalogue across multiple sales channels: root categories, products, variants, manufacturers, properties, media and tags.",
            "fr-FR": "G\u00e9n\u00e8re un catalogue de d\u00e9monstration Shopware 6 r\u00e9aliste et idempotent sur plusieurs canaux de vente : cat\u00e9gories racines, produits, variantes, fabricants, propri\u00e9t\u00e9s, m\u00e9dias et tags."
        },
        "manufacturerLink": {
            "de-DE": "https://kommandhub.com",
            "en-GB": "https://kommandhub.com"
        },
        "supportLink": {
            "de-DE": "https://kommandhub.com/support",
            "en-GB": "https://kommandhub.com/support"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
